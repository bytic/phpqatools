{
  "name": "bytic/phpqatools",
  "description": "Composer plugin providing PHP quality assurance tools and commands",
  "license": "MIT",
  "type": "composer-plugin",
  "keywords": [
    "php",
    "qa",
    "quality",
    "code quality",
    "stylecheck",
    "unittest"
  ],
  "authors": [
    {
      "name": "Solomon Gabriel",
      "email": "hello@gabrielsolomon.ro",
      "homepage": "http://gabrielsolomon.ro",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "composer-plugin-api": "^2",
    "bytic/phpqaconfig": "^1.0",
    "ergebnis/composer-normalize": "^2.7",
    "friendsofphp/php-cs-fixer": "^3.0",
    "madewithlove/license-checker": "^2.0 || ^3.0",
    "mockery/mockery": "^1.6",
    "pdepend/pdepend": "^2.16 || ^3.0",
    "phpmd/phpmd": "^2.15 || ^3.0",
    "phpstan/extension-installer": "^1.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-mockery": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "psalm/plugin-mockery": "^1.0",
    "psalm/plugin-phpunit": "^0.20 || ^0.22 || ^1.0",
    "roave/security-advisories": "dev-latest"
  },
  "require-dev": {
    "composer/composer": "^2.0"
  },
  "suggest": {
    "phploc/phploc": "^7.0",
    "phpmetrics/phpmetrics": "^2.3",
    "seld/jsonlint": "^1.6",
    "sllh/composer-versions-check": "^2.0",
    "wimg/php-compatibility": "^8.0 || ^9.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Bytic\\Phpqa\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bytic\\Phpqa\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "extra": {
    "class": "Bytic\\Phpqa\\Composer\\DevToolsPlugin"
  },
  "scripts": {
    "analyse": "@php vendor/bin/phpstan analyse src tests --no-progress",
    "test": "@php vendor/bin/phpunit --no-coverage tests"
  }
}
